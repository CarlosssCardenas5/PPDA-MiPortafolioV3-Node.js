<%- include('partials/head') %>

			<!-- Main -->
			<div id="main">

				<article id="sobre-mi" class="post">
					<header>
						<div class="title">
							<h2>Sobre mí</h2>
							<p>Conoce un poco más sobre mi perfil académico y profesional</p>
						</div>
					</header>
					<a class="image featured">
						<img src="/images/pic01.jpg" alt="Carlos Andre - Ingeniería de Sistemas" />
					</a>
					<p>
						Soy Carlos Andre Cardenas Del Castillo, estudiante de Ingeniería
						de Sistemas. Durante mi formación universitaria he desarrollado
						diferentes proyectos relacionados con desarrollo de software,
						aplicaciones móviles, sistemas operativos, bases de datos y
						tecnologías web.
					</p>
					<p>
						Me interesa continuar fortaleciendo mis conocimientos en
						programación y desarrollo de soluciones tecnológicas. Busco
						aplicar lo aprendido en proyectos que permitan resolver
						problemas reales mediante la tecnología.
					</p>
				</article>

				<article id="proyectos" class="post">
					<header>
						<div class="title">
							<h2>Mis proyectos</h2>
							<p>Algunos proyectos desarrollados durante mi formación</p>
						</div>
					</header>
					<a class="image featured">
						<img src="/images/pic02.jpg" alt="Proyectos de Carlos Andre" />
					</a>
					<% proyectos.forEach(function (p) { %>
						<h3><a href="/proyectos/<%= p.slug %>"><%= p.titulo %></a></h3>
						<p><%= p.resumen %></p>
					<% }); %>
				</article>

				<article id="habilidades" class="post">
					<header>
						<div class="title">
							<h2>Mis habilidades</h2>
							<p>Tecnologías y herramientas que he utilizado</p>
						</div>
					</header>
					<a class="image featured">
						<img src="/images/pic03.jpg" alt="Tecnologías y habilidades" />
					</a>
					<h3>Desarrollo Web</h3>
					<p>HTML5, CSS3 y JavaScript para la creación de sitios web interactivos y responsive.</p>
					<h3>Desarrollo de aplicaciones móviles</h3>
					<p>
						Flutter y Dart para el desarrollo de aplicaciones móviles,
						trabajando con interfaces, almacenamiento local y servicios
						de autenticación.
					</p>
					<h3>Bases de datos</h3>
					<p>
						Experiencia académica con MySQL, SQL Server, Oracle y MongoDB,
						incluyendo consultas, modelado y gestión de información.
					</p>
					<h3>Sistemas Operativos</h3>
					<p>
						Conocimientos de Linux, lenguaje C, administración de archivos,
						memoria, paginación y otros fundamentos de Sistemas Operativos.
					</p>
				</article>

				<article id="contacto" class="post">
					<header>
						<div class="title">
							<h2>Contacto</h2>
							<p>Puedes comunicarte conmigo a través de los siguientes medios</p>
						</div>
					</header>
					<a class="image featured">
						<img src="/images/pic04.jpg" alt="Contacto de Carlos Andre" />
					</a>
					<h3>Correo electrónico</h3>
					<p>Puedes escribirme a través de mi correo electrónico para comunicarte conmigo.</p>
					<ul class="actions">
						<li><a href="mailto:carandre1020@gmail.com" class="button">Enviar correo</a></li>
					</ul>
					<h3>GitHub</h3>
					<p>En mi perfil de GitHub puedes encontrar algunos de mis proyectos y trabajos relacionados con desarrollo de software.</p>
					<ul class="actions">
						<li><a href="https://github.com/CarlosssCardenas5" target="_blank" class="button">Ver GitHub</a></li>
					</ul>
					<h3>Telefono</h3>
					<p>También puedes enviarme un mensaje por Whatsapp para conocer más sobre mi formación y experiencia.</p>
					<h3>974735469</h3>
					<br />
					<h4>¿Tienes un proyecto?</h4>
					<p>
						Si deseas proponer una idea, proyecto o colaboración,
						puedes completar el siguiente formulario y contarme
						un poco más sobre tu propuesta.
					</p>
					<form id="form-colaboracion">
						<div class="row gtr-uniform">
							<div class="col-6 col-12-xsmall">
								<input type="text" name="nombre" id="nombre" placeholder="Tu nombre" required />
							</div>
							<div class="col-6 col-12-xsmall">
								<input type="email" name="correo" id="correo" placeholder="Tu correo electrónico" required />
							</div>
							<div class="col-12">
								<select name="tipo-proyecto" id="tipo-proyecto" required>
									<option value="">- Tipo de proyecto -</option>
									<option value="desarrollo-web">Desarrollo web</option>
									<option value="aplicacion-movil">Aplicación móvil</option>
									<option value="sistema">Sistema de información</option>
									<option value="otro">Otro</option>
								</select>
							</div>
							<div class="col-12">
								<textarea name="mensaje" id="mensaje" placeholder="Cuéntame sobre tu proyecto o propuesta..." rows="6" required></textarea>
							</div>
							<div class="col-12">
								<ul class="actions">
									<li><button type="submit" class="button">Solicitar colaboración</button></li>
									<li><button type="reset" class="button">Limpiar</button></li>
								</ul>
							</div>
						</div>
					</form>
					<p id="mensaje-formulario" style="display: none;"></p>
				</article>

			</div>

			<!-- Sidebar -->
			<section id="sidebar">

				<section id="intro">
					<a href="#" class="logo"><img src="/images/logo.jpg" alt="" /></a>
					<header>
						<h2>Mi Portafolio Personal</h2>
						<p>Carlos Andre Cárdenas Del Castillo</p>
					</header>
				</section>

				<section>
					<h2>Mis proyectos</h2>
					<div class="mini-posts">
						<% proyectos.forEach(function (p) { %>
							<article class="mini-post">
								<header>
									<h3><a href="/proyectos/<%= p.slug %>"><%= p.titulo %></a></h3>
									<p><%= p.stack %></p>
								</header>
								<a href="/proyectos/<%= p.slug %>" class="image">
									<img src="/images/<%= p.imgMini %>" alt="<%= p.titulo %>" />
								</a>
							</article>
						<% }); %>
					</div>
				</section>

				<%- include('partials/redes') %>

			</section>

<%- include('partials/scripts') %>
